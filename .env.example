# Copy to ~/.config/israel-school/.env (survives skill updates) or to .env in the skill
# folder (gitignored), then fill in. Never commit real values.
# Wrap values in single quotes: an unquoted # starts a comment and cuts the value short.

# Access level:
#   read        (default) only reads.
#   full        allows calls that change data; each asks you first, in a dialog or
#               ahead of time with `scripts/school grant`.
#   unattended  allows calls that change data without asking. Use only for runs with
#               nobody at the computer, such as scheduled tasks.
SCHOOL_ACCESS=read

# Mashov (https://web.mashov.info)
MASHOV_USERNAME=
MASHOV_PASSWORD=
# School code ("semel"); look it up with `school mashov schools`.
MASHOV_SEMEL=
# Optional: school year (defaults to the current one) and a fixed student id.
MASHOV_YEAR=
MASHOV_STUDENT_ID=

# SmartSchool Webtop (https://webtop.smartschool.co.il)
# Password login is captcha-gated, so paste the browser's webToken cookie here.
SMARTSCHOOL_WEB_TOKEN=
# Optional unattended renewal from a browser-captured loginByBio request.
SMARTSCHOOL_BIO_LOGIN=
SMARTSCHOOL_UNIQUE_ID=
SMARTSCHOOL_SELECTED_USER=
SMARTSCHOOL_DEVICE_ID=
